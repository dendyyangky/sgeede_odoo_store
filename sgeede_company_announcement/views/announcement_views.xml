<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_announcement_list" model="ir.ui.view">
        <field name="name">company.announcement.list</field>
        <field name="model">company.announcement</field>
        <field name="arch" type="xml">
            <tree decoration-muted="state == 'draft'" decoration-success="state == 'published' and is_visible">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="level"/>
                <field name="state"/>
                <field name="start_datetime"/>
                <field name="end_datetime"/>
                <field name="company_ids" widget="many2many_tags"/>
                <field name="is_visible"/>
            </tree>
        </field>
    </record>

    <record id="view_company_announcement_form" model="ir.ui.view">
        <field name="name">company.announcement.form</field>
        <field name="model">company.announcement</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_publish" string="Publish" type="object" class="btn-primary" invisible="state == 'published'"/>
                    <button name="action_unpublish" string="Unpublish" type="object" invisible="state != 'published'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,published"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="level"/>
                            <field name="company_ids" widget="many2many_tags"/>
                        </group>
                        <group>
                            <field name="start_datetime"/>
                            <field name="end_datetime"/>
                            <field name="is_visible" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Message">
                            <field name="message" placeholder="Write the announcement shown in the banner."/>
                        </page>
                        <page string="Dismissed By">
                            <field name="dismissed_user_ids" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_company_announcement_search" model="ir.ui.view">
        <field name="name">company.announcement.search</field>
        <field name="model">company.announcement</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter name="published" string="Published" domain="[('state', '=', 'published')]"/>
                <filter name="visible" string="Visible Now" domain="[('is_visible', '=', True)]"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="group_by_state" string="Status" context="{'group_by': 'state'}"/>
                <filter name="group_by_level" string="Level" context="{'group_by': 'level'}"/>
            </search>
        </field>
    </record>

    <record id="action_company_announcement" model="ir.actions.act_window">
        <field name="name">Announcements</field>
        <field name="res_model">company.announcement</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_published': 1}</field>
    </record>

    <menuitem id="menu_company_announcement_root"
        name="Announcements"
        sequence="75"
        web_icon="sgeede_company_announcement,static/description/icon.png"
        groups="base.group_system"/>

    <menuitem id="menu_company_announcement"
        name="Internal Announcements"
        parent="menu_company_announcement_root"
        action="action_company_announcement"
        sequence="10"
        groups="base.group_system"/>
</odoo>
