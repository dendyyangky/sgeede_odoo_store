<odoo>
    <record id="sgeede_hr_leave_allocation_view_form_inherit" model="ir.ui.view">
        <field name="name">sgeede.hr.leave.allocation.form</field>
        <field name="model">hr.leave.allocation</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_allocation_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='notes']" position="after">
                <field name="allocation_ids" groups="sgeede_base.sgeede_singaporean_leave_groups">
                    <list context="{'default_allocation_id': id}" editable="bottom">
                        <field name="name"/>
                        <field name="holiday_status_id"/>
                        <field name="date_from"/>
                        <field name="number_of_days_display"/>
                    </list>
                </field>
            </xpath>           
        </field>
    </record>
</odoo>