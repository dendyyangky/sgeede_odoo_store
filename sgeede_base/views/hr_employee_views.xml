<odoo>
    <record id="sgeede_view_employee_form_inherit" model="ir.ui.view">
        <field name="name">hr.employee.form</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='parent_id']" position="after">
                <field name="join_date" groups="sgeede_base.sgeede_singaporean_leave_groups"/>
            </xpath>
            <xpath expr="//field[@name='sex']" position="after">
                <field name="is_pregnant" invisible="sex != 'female'" groups="sgeede_base.sgeede_singaporean_leave_groups"/>
            </xpath>
            <xpath expr="//field[@name='spouse_complete_name']" position="after">
                <field name="spouse_country_id" invisible="marital != 'married'" groups="sgeede_base.sgeede_singaporean_leave_groups"/>
            </xpath>
            <xpath expr="//notebook/page[@name='personal_information']" position="after">
                <page string="Children Details" groups="sgeede_base.sgeede_singaporean_leave_groups">
                    <field name="children_ids">
                        <list context="{'default_employee_id': id}">
                            <field name="name"/>
                            <field name="gender"/>
                            <field name="dob"/>
                            <field name="is_singapore_citizen"/>
                            <field name="children_type"/>
                            <!-- <field name="adoption_date"/> -->
                            <field name="formal_intent_to_adopt_date" />
                        </list>
                        <form>
                            <div class="oe_title">
                                <field name="name" placeholder="e.g. Marc Demo" class="h1"/>
                            </div>
                            <group>
                                <group>
                                    <field name="gender"/>
                                    <field name="dob"/>
                                </group>
                                <group>
                                    <field name="is_singapore_citizen" widget="radio" options="{'horizontal': True}"/>
                                    <field name="children_type" widget="radio" options="{'horizontal': True}"/>
                                    <!-- <field name="adoption_date" required="children_type == 'adopted'" invisible="children_type != 'adopted'"/> -->
                                    <field name="adoption_type" widget="radio" options="{'horizontal': True}" required="children_type == 'adopted'" invisible="children_type != 'adopted'"/>
                                </group>

                                <group string="Formal Intent to Adopt" invisible="children_type != 'adopted'">
                                    <field name="formal_intent_to_adopt_date" readonly="1"/>
                                    <field name="filing_court_date" invisible="adoption_type != 'local'"/>
                                    <field name="ipa_date" invisible="adoption_type != 'foreign'"/>
                                    <field name="adoption_order_date" invisible="children_type != 'adopted'" required="children_type == 'adopted'"/>
                                </group>
                            </group>
                        </form>
                    </field>
                </page>
            </xpath>
            <xpath expr="//field[@name='marital']" position="after">
                <field name="marriage_date" invisible="marital != 'married'" groups="sgeede_base.sgeede_singaporean_leave_groups"/>
                <field name="is_spouse_pregnant" invisible="marital != 'married' or sex != 'male'" groups="sgeede_base.sgeede_singaporean_leave_groups"/>
                <field name="edd_date" invisible="is_spouse_pregnant != True" groups="sgeede_base.sgeede_singaporean_leave_groups"/>
            </xpath>
        </field>
    </record>
</odoo>