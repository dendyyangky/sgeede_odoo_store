        <record id="action_sgeede_payment_distribution" model="ir.actions.act_window">
            <field name="name">Payment Distribution</field>
            <field name="res_model">sgeede.payment.distribution</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create Payment Distribution.
                </p>
            </field>
        </record>

        <menuitem id="menu_sgeede_payment_distribution"
                name="Payment Distribution"
                action="action_sgeede_payment_distribution"
                parent="account.menu_finance_entries"
                groups="sgeede_base.sgeede_payment_distribution_groups"
                sequence="15"/>
    </data>
</odoo>