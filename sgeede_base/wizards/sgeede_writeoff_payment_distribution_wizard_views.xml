<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="sgeede_writeoff_payment_wizard_form" model="ir.ui.view">
            <field name="name">sgeede.writeoff.payment.wizard.form</field>
            <field name="model">sgeede.writeoff.payment.wizard</field>
            <field name="arch" type="xml">
                <form string="Write-off">
                    <group>
                        <group>
                            <field name="account_id"/>
                            <field name="journal_id"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="amount"/>
                            <field name="move_line_ids" invisible="1" force_save="1"/>
                        </group>
                    </group>
                    <footer>
                        <button name="make_payment_distribution_writeoff" string="Pay" type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

    </data>
</odoo>
