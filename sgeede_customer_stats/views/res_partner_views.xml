<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_sale_customer_statistics" model="ir.ui.view">
        <field name="name">res.partner.form.sale.customer.statistics</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='sale.act_res_partner_2_sale_order']" position="replace">
                <button
                    name="action_view_confirmed_sale_orders"
                    type="object"
                    class="oe_stat_button"
                    groups="sales_team.group_sale_salesman"
                    icon="fa-usd">
                    <field name="sale_order_count" string="Sales Orders" widget="statinfo"/>
                </button>
            </xpath>

            <xpath expr="//notebook" position="inside">
                <page string="Sales Statistics" name="sales_statistics">
                    <group>
                        <group>
                            <field name="quotation_count" readonly="1"/>
                            <field name="sale_order_count" readonly="1"/>
                            <field name="last_order_date" readonly="1"/>
                        </group>
                        <group>
                            <field name="currency_id" invisible="1"/>
                            <field name="total_sales_amount" widget="monetary" readonly="1"/>
                            <field name="average_order_value" widget="monetary" readonly="1"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_res_partner_filter_sale_customer_statistics" model="ir.ui.view">
        <field name="name">res.partner.search.sale.customer.statistics</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='inactive']" position="after">
                <separator/>
                <filter
                    string="Customers With Sales"
                    name="customers_with_sales"
                    domain="[('sale_order_count', '&gt;', 0)]"/>
                <filter
                    string="Customers With Quotations"
                    name="customers_with_quotations"
                    domain="[('quotation_count', '&gt;', 0)]"/>
            </xpath>
        </field>
    </record>
</odoo>
