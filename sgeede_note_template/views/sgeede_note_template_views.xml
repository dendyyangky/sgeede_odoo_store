<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="sgeede_note_template_action" model="ir.actions.act_window">
        <field name="name">Note Templates</field>
        <field name="res_model">sgeede.note.template</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p>Create Your Note Template Here!</p>
        </field>
    </record>

    <record id="sgeede_note_template_view_list" model="ir.ui.view">
        <field name="name">sgeede.note.template.view.list</field>
        <field name="model">sgeede.note.template</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="note"/>
                <field name="apply_to"/>
            </tree>
        </field>
    </record>

    <record id="sgeede_note_template_view_form" model="ir.ui.view">
        <field name="name">sgeede.note.template.view.form</field>
        <field name="model">sgeede.note.template</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder='Template Name'/>
                        </h1>
                    </div>
                    <group>
                        <field name="note"/>
                        <field name="apply_to" widget='radio'/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <menuitem
        id="sgeede_sale_note_template_menu"
        name="Note Template"
        parent="sale.menu_sale_config"
        sequence="100"/>

    <menuitem
        id="sgeede_sale_note_template_create_menu"
        name="Templates"
        action="sgeede_note_template.sgeede_note_template_action"
        parent="sgeede_note_template.sgeede_sale_note_template_menu"
        sequence="10"/>

    <menuitem
        id="sgeede_purchase_note_template_menu"
        name="Note Template"
        parent="purchase.menu_purchase_config"
        sequence="40"/>

    <menuitem
        id="sgeede_purchase_note_template_create_menu"
        name="Templates"
        action="sgeede_note_template.sgeede_note_template_action"
        parent="sgeede_note_template.sgeede_purchase_note_template_menu"
        sequence="10"/>

</odoo>
