<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="sgeede_inherit_purchase_order_form" model="ir.ui.view">
        <field name="name">sgeede.inherit.purchase.view.form</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[group/field[@name='notes']]" position="before">
                <group>
                    <group>
                        <field name="note_template" domain="[('apply_to','in',['purchase', 'both'])]"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
