<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="sgeede_inherit_sale_order_form" model="ir.ui.view">
        <field name="name">sgeede.inherit.sale.view.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='note_group']" position="before">
                <group>
                    <group>
                        <field name="note_template" domain="[('apply_to','in',['sale', 'both'])]"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
